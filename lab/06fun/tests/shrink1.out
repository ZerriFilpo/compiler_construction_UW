def soma(x, y):
    return x + y

def positivo(x):
    return x < 100 if x > 0 else False

def escolhe(a, b):
    if True if a > b else a == 0:
        return a
    else:
        return b

def main():
    x = soma(1, 2)
    print(x)
    print(escolhe(soma(x, 1), 3))
    if not x == 5 if positivo(x) else False:
        print(1)
    return 0
