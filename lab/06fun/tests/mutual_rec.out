def even(n):
    if n == 0:
      return True
    else:
      %tmp1 = (n - 1)
      return odd(%tmp1)

def odd(n):
    if n == 0:
      return False
    else:
      %tmp2 = (n - 1)
      return even(%tmp2)

def main():
    x = input_int()
    if ({
      %tmp3 = odd(x)
      produce not(%tmp3)
    } if even(x) else False):
      print(1)
    else:
      print(0)
    return 0


